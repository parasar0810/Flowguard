# ============================================================
#  FlowGuard Environment Variables
#  Copy this file to .env and fill in production values
# ============================================================

# ── Server ──────────────────────────────────────────────────
SERVER_PORT=8080

# ── Database (PostgreSQL) ───────────────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/flowguard
DB_USERNAME=flowguard
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092

# ── JWT Secret ──────────────────────────────────────────────
# IMPORTANT: Generate a unique 256-bit (32-byte) hex key for production!
# Example: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRATION=86400000

# ── Grafana ─────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=admin
